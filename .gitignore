# Keep local backup artifacts out of Git
.backups/
*.tmp
*.bak
*.swp
.DS_Store

# Do not ignore brain/hermes-home/.env: this repo intentionally supports plaintext full sync for testing.

# Runtime/transient Hermes files excluded by sync scripts; keep ignores here as a safety net.
brain/hermes-home/logs/
brain/hermes-home/cache/
brain/hermes-home/audio_cache/
brain/hermes-home/**/__pycache__/
brain/hermes-home/**/*.pyc
brain/hermes-home/**/*.lock
brain/hermes-home/**/*.pid
brain/hermes-home/**/*.log
brain/hermes-home/**/*-wal
brain/hermes-home/**/*-shm
brain/hermes-home/hermes-agent/
